<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.ai</groupId>
        <artifactId>ddd4j-ai-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-ai-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-ai-sample-app</artifactId>
    <description>可运行示例应用：Ollama + ddd4j-ai 全组件（chat/memory/embedding/vectordb/rag）开箱演示</description>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 模型接入：Ollama starter 提供 ChatModel/EmbeddingModel/ChatClient.Builder -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- ddd4j-ai 组件（引依赖即自动装配 ChatService/MemoryService/EmbeddingService/RagService） -->
        <dependency>
            <groupId>io.ddd4j.ai</groupId>
            <artifactId>ddd4j-ai-extension-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.ai</groupId>
            <artifactId>ddd4j-ai-extension-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.ai</groupId>
            <artifactId>ddd4j-ai-extension-embedding</artifactId>
        </dependency>
        <!-- RAG 演示使用内存向量库（SimpleVectorStore），无需外部向量数据库 -->
        <dependency>
            <groupId>io.ddd4j.ai</groupId>
            <artifactId>ddd4j-ai-extension-vectordb</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.ai</groupId>
            <artifactId>ddd4j-ai-extension-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>ollama</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.0.7</version>
            </plugin>
        </plugins>
    </build>

</project>
