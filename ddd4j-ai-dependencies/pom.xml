<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.ai</groupId>
        <artifactId>ddd4j-ai</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-ai-dependencies</artifactId>
    <packaging>pom</packaging>
    <description>
        Ddd4j AI 依赖 BOM：import io.ddd4j.boot:ddd4j-boot-dependencies（Boot 第三方 + Spring Framework），
        并追加 Spring AI、Spring AI Alibaba、LangChain4j、AgentScope Java、MCP、语音与文档处理等
        AI 专属依赖版本管理。
    </description>

    <properties>
        <ddd4j-boot.version>3.4.x.20260630-SNAPSHOT</ddd4j-boot.version>
        <jackson-bom.version>2.22.1</jackson-bom.version>
        <!-- ddd4j-ai-sdk-deps 模块专用 easy4j AI SDK 版本（自 ddd4j 主仓 ddd4j-ai-dependencies 迁入） -->
        <easy4j-claudecode-java-sdk.version>3.0.x.20260630-SNAPSHOT</easy4j-claudecode-java-sdk.version>
        <easy4j-codex-java-sdk.version>3.0.x.20260630-SNAPSHOT</easy4j-codex-java-sdk.version>
        <easy4j-dreamina-java-sdk.version>3.0.x.20260630-SNAPSHOT</easy4j-dreamina-java-sdk.version>
        <tts-edge-java.version>1.3.3</tts-edge-java.version>
        <protobuf-java.version>4.35.1</protobuf-java.version>
        <google-protos.version>2.74.0</google-protos.version>
        <jsonschema.version>5.0.0</jsonschema.version>
        <mcp-bom.version>2.0.0</mcp-bom.version>
        <microsoft-speech-sdk.version>1.51.1</microsoft-speech-sdk.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <spring-ai-alibaba.version>2.0.0-M1.1</spring-ai-alibaba.version>
        <spring-ai-alibaba-extensions.version>${spring-ai-alibaba.version}</spring-ai-alibaba-extensions.version>
        <spring-ai-alibaba-nl2sql.version>1.0.0.3-20260305-cve</spring-ai-alibaba-nl2sql.version>
        <spring-ai-alibaba-graph.version>${spring-ai-alibaba.version}</spring-ai-alibaba-graph.version>
        <spring-ai-community.version>1.0.0</spring-ai-community.version>
        <spring-ai-retry.version>${spring-ai.version}</spring-ai-retry.version>
        <langchain4j.version>1.19.0</langchain4j.version>
        <agentscope-java.version>2.0.2</agentscope-java.version>
        <whispercpp.version>1.4.0</whispercpp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson 版本治理（项目规范）：1.0.x 线基于 Jackson 2，
                 import com.fasterxml.jackson:jackson-bom；dependencies 直接使用组件不写版本号。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Boot 3.4 基线显式对齐（与 2.0.x 线同因）：上游传递 BOM 未覆盖 spring-boot-* 管理，
                 组件依赖 spring-boot-autoconfigure/starter-test 需版本来源 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.4.13</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 1. AI 专属依赖管理优先声明，确保其版本覆盖 Boot 通用依赖管理中的旧 AI 组件 -->

            <!-- https://mvnrepository.com/artifact/com.google.api.grpc/proto-google-common-protos -->
            <dependency>
                <groupId>com.google.api.grpc</groupId>
                <artifactId>proto-google-common-protos</artifactId>
                <version>${google-protos.version}</version>
            </dependency>

            <!-- This SDK allows you to use the Microsoft Cognitive Speech Service. See https://aka.ms/csspeech for more information. -->
            <!-- https://mvnrepository.com/artifact/com.microsoft.cognitiveservices.speech/client-sdk -->
            <dependency>
                <groupId>com.microsoft.cognitiveservices.speech</groupId>
                <artifactId>client-sdk</artifactId>
                <version>${microsoft-speech-sdk.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/io.modelcontextprotocol.sdk/mcp-bom -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI 生态 BOM 与扩展 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-bom -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-extensions-bom -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba-extensions.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- https://central.sonatype.com/artifact/dev.langchain4j/langchain4j-bom -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- https://central.sonatype.com/artifact/io.agentscope/agentscope-bom -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Boot 依赖 BOM：第三方库 + Spring Framework 版本对齐（不含 Spring Boot 自身，由 starter-parent 提供） -->
            <dependency>
                <groupId>io.ddd4j.boot</groupId>
                <artifactId>ddd4j-boot-dependencies</artifactId>
                <version>${ddd4j-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. 未纳入上述 BOM 的 AI 专属第三方依赖 -->
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-starter-tool-calling-bingsearch -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-starter-tool-calling-bingsearch</artifactId>
                <version>1.0.0.2</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-nl2sql-chat -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-nl2sql-chat</artifactId>
                <version>${spring-ai-alibaba-nl2sql.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-nl2sql-common -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-nl2sql-common</artifactId>
                <version>${spring-ai-alibaba-nl2sql.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.alibaba.cloud.ai/spring-ai-alibaba-graph-core -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-graph-core</artifactId>
                <version>${spring-ai-alibaba-graph.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springaicommunity/moonshot-core -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>moonshot-core</artifactId>
                <version>${spring-ai-community.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springaicommunity/spring-ai-autoconfigure-model-qianfan -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-autoconfigure-model-qianfan</artifactId>
                <version>${spring-ai-community.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springaicommunity/qianfan-core -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>qianfan-core</artifactId>
                <version>${spring-ai-community.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springaicommunity/spring-ai-autoconfigure-model-moonshot -->
            <dependency>
                <groupId>org.springaicommunity</groupId>
                <artifactId>spring-ai-autoconfigure-model-moonshot</artifactId>
                <version>${spring-ai-community.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springframework.ai/spring-ai-retry -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-retry</artifactId>
                <version>${spring-ai-retry.version}</version>
            </dependency>
            <!-- For TTS : https://github.com/WhiteMagic2014/tts-edge-java -->
            <!-- https://mvnrepository.com/artifact/io.github.whitemagic2014/tts-edge-java -->
            <dependency>
                <groupId>io.github.whitemagic2014</groupId>
                <artifactId>tts-edge-java</artifactId>
                <version>${tts-edge-java.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/io.github.ggerganov/whispercpp -->
            <dependency>
                <groupId>io.github.ggerganov</groupId>
                <artifactId>whispercpp</artifactId>
                <version>${whispercpp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
